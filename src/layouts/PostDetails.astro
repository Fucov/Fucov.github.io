---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import Comments from "@/components/Comments.astro";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
} = post.data;

const { Content, headings } = await render(post);
const tocHeadings = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
const showToc = tocHeadings.length >= 4;

let ogImageUrl: string | undefined;

if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}

if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
};

const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath,
}));

const currentPostIndex = allPosts.findIndex(a => a.id === post.id);

const prevPost = currentPostIndex !== 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex !== allPosts.length ? allPosts[currentPostIndex + 1] : null;
---

<Layout {...layoutProps}>
  <Header />
  <BackButton />
  <main
    id="main-content"
    class:list={["article-layout mx-auto w-full pb-12", { "mt-8": !SITE.showBackButton }]}
    style="width: 100%; max-width: min(96vw, 1480px);"
    data-pagefind-body
  >
    <h1
      transition:name={slugifyStr(title.replaceAll(".", "-"))}
      class="inline-block text-2xl font-bold text-accent sm:text-3xl"
    >
      {title}
    </h1>
    <div class="my-2 flex items-center gap-2">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      <span
        aria-hidden="true"
        class:list={[
          "max-sm:hidden",
          { hidden: !SITE.editPost.enabled || hideEditPost },
        ]}>|</span
      >
      <EditPost {hideEditPost} {post} class="max-sm:hidden" />
    </div>
    <div
      class:list={["post-reading-layout mt-8", { "has-toc": showToc }]}
      data-post-reading-layout
      data-toc-collapsed="false"
    >
      {showToc && (
        <aside class="post-toc" aria-label="文章目录" data-pagefind-ignore>
          <button
            type="button"
            class="post-toc-toggle"
            data-toc-toggle
            aria-controls="post-toc-nav"
            aria-expanded="true"
          >
            <span>目录</span>
            <span data-toc-toggle-label>收起</span>
          </button>
          <nav class="post-toc-nav" id="post-toc-nav" aria-label="章节导航">
            <ul>
              {tocHeadings.map(heading => (
                <li class:list={[{ "toc-subheading": heading.depth === 3 }]}>
                  <a href={`#${heading.slug}`} data-toc-target={heading.slug}>
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
      <article
        id="article"
        class="app-prose w-full max-w-none prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
        style="width: 100%; max-width: none;"
      >
        <Content />
      </article>
    </div>

    <hr class="my-8 border-dashed" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>

    <BackToTopButton />

    <ShareLinks />

    <Comments />

    <hr class="my-10 border-dashed" />

    <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        prevPost && (
          <a
            href={getPath(prevPost.id, prevPost.filePath)}
            class="flex w-full gap-1 hover:opacity-75"
          >
            <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
            <div>
              <span>Previous Post</span>
              <div class="text-sm text-accent/85">{prevPost.title}</div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={getPath(nextPost.id, nextPost.filePath)}
            class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
          >
            <div>
              <span>Next Post</span>
              <div class="text-sm text-accent/85">{nextPost.title}</div>
            </div>
            <IconChevronRight class="inline-block flex-none rtl:rotate-180" />
          </a>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>

<script is:inline data-astro-rerun>
  function createProgressBar() {
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-background";

    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    progressContainer.appendChild(progressBar);
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  // Each rendered article owns its own TOC. No site-wide layout state.
  (function initPostToc() {
    const layout = document.querySelector("[data-post-reading-layout].has-toc");
    if (!layout || layout.dataset.tocInitialized === "true") return;
    layout.dataset.tocInitialized = "true";
    const toggle = layout.querySelector("[data-toc-toggle]");
    const label = layout.querySelector("[data-toc-toggle-label]");
    const nav = layout.querySelector(".post-toc-nav");
    const links = Array.from(nav.querySelectorAll("[data-toc-target]"));
    const desktop = window.matchMedia("(min-width: 1100px)");
    function setCollapsed(collapsed) {
      layout.dataset.tocCollapsed = String(collapsed);
      toggle.setAttribute("aria-expanded", String(!collapsed));
      nav.hidden = collapsed;
      label.textContent = collapsed ? "展开" : "收起";
    }
    setCollapsed(!desktop.matches);
    toggle.addEventListener("click", () => {
      setCollapsed(layout.dataset.tocCollapsed !== "true");
    });
    nav.addEventListener("click", event => {
      if (event.target.closest("a") && !desktop.matches) setCollapsed(true);
    });
    const targets = links.map(link => document.getElementById(link.dataset.tocTarget));
    let scheduled = false;
    function updateActive() {
      scheduled = false;
      let index = -1;
      for (let i = 0; i < targets.length; i++) {
        if (targets[i] && targets[i].getBoundingClientRect().top <= 104) index = i;
      }
      links.forEach((link, i) => {
        if (i === index) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    }
    function queueActive() {
      if (!scheduled) {
        scheduled = true;
        requestAnimationFrame(updateActive);
      }
    }
    window.addEventListener("scroll", queueActive, { passive: true });
    window.addEventListener("resize", queueActive, { passive: true });
    document.addEventListener("astro:before-swap", () => {
      window.removeEventListener("scroll", queueActive);
      window.removeEventListener("resize", queueActive);
    }, { once: true });
    updateActive();
  })();

  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      const topClass = hasFileNameOffset
        ? "top-(--file-name-offset)"
        : "-top-3";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");
      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );
</script>


<style>
  .post-reading-layout {
    min-width: 0;
  }
  .post-reading-layout > article {
    min-width: 0;
  }
  .post-toc {
    min-width: 0;
    color: var(--foreground);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px;
    background: var(--background);
    align-self: start;
  }
  .post-toc-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 16px;
    font-size: 14px;
    font-weight: 650;
    text-align: left;
    line-height: 1.5;
    color: var(--foreground);
    padding: 5px 8px;
    border-radius: 6px;
  }
  .post-toc-toggle:hover { background: var(--muted); }
  .post-toc-toggle [data-toc-toggle-label] {
    font-size: 12px;
    font-weight: 400;
    color: var(--accent);
    white-space: nowrap;
  }
  .post-toc-nav {
    max-height: 42vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    margin-top: 10px;
    padding-right: 3px;
    scrollbar-width: thin;
  }
  .post-toc-nav[hidden] { display: none; }
  .post-toc-nav ul { list-style: none; margin: 0; padding: 0; }
  .post-toc-nav li { margin: 2px 0; }
  .post-toc-nav a {
    display: block;
    padding: 5px 8px;
    font-size: 13px;
    line-height: 1.5;
    overflow-wrap: anywhere;
    border-left: 2px solid transparent;
    text-decoration: none;
    border-radius: 0 5px 5px 0;
  }
  .post-toc-nav .toc-subheading a {
    padding-left: 20px;
    font-size: 12px;
    opacity: 0.82;
  }
  .post-toc-nav a:hover,
  .post-toc-nav a[aria-current="location"] {
    color: var(--accent);
    background: var(--muted);
    border-left-color: var(--accent);
    opacity: 1;
  }
  .post-reading-layout.has-toc { display: grid; gap: 20px; grid-template-columns: minmax(0, 1fr); }
  .post-reading-layout[data-toc-collapsed="true"] { grid-template-columns: minmax(0, 1fr); }
  .post-reading-layout[data-toc-collapsed="true"] .post-toc {
    padding: 3px;
    width: max-content;
    justify-self: end;
    position: sticky;
    top: 12px;
    z-index: 8;
    box-shadow: 0 2px 8px #00000014;
  }
  .post-reading-layout[data-toc-collapsed="true"] .post-toc-toggle { width: auto; }
  @media (min-width: 1100px) {
    .post-reading-layout.has-toc:not([data-toc-collapsed="true"]) {
      grid-template-columns: minmax(220px, 260px) minmax(0, 1fr);
      gap: 30px;
    }
    .post-reading-layout.has-toc:not([data-toc-collapsed="true"]) .post-toc {
      position: sticky;
      top: 20px;
    }
    .post-toc-nav { max-height: calc(100vh - 110px); }
  }
  @media print {
    .post-toc { display: none !important; }
    .post-reading-layout.has-toc { display: block !important; }
  }
</style>
