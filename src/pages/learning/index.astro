---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/layouts/Main.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
const posts = getSortedPosts((await getCollection("blog")).filter(p => p.data.tags.includes("learning-daily")));
const tags = [...new Set(posts.flatMap(p => p.data.tags))].filter(t => t !== "learning-daily");
---
<Layout title="学习日报" description="按日期积累研究与工程进展，随学习方向扩展主题。">
  <Header />
  <Main pageTitle="学习日报" pageDesc="按日期积累，按主题串联。研究方向会变化，学习记录持续保留。">
    <section class="mb-8 rounded-lg border border-border p-5">
      <h2 class="text-xl font-semibold">首批同步 · 2026-10-02 — 2026-10-08</h2>
      <p class="mt-3">7 天已有速通版，含两天空报。当前主题为 LLM Systems，后续可扩展到其他研究方向。</p>
      <p class="mt-3">点击日期进入报告，文内可跳转前后一天；标签可跨日期浏览相近主题，站内搜索可检索报告内容。</p>
      <div class="mt-4 flex flex-wrap gap-3">{tags.map(tag => <a class="underline" href={`/tags/${tag}/`}>#{tag}</a>)}</div>
    </section>
    <h2 class="text-xl font-semibold">日期归档</h2>
    <ul>{posts.map(post => <Card {...post} />)}</ul>
  </Main>
  <Footer />
</Layout>
