---
import { Image } from "astro:assets";
import heroImage from "@/assets/images/home-hero.png";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import IconMail from "@/assets/icons/IconMail.svg";
import IconCSDN from "@/assets/icons/IconCSDN.svg";
import LinkButton from "./LinkButton.astro";

const introLinks = [
  {
    href: "https://github.com/Fucov",
    label: "GitHub",
    title: "Fucov on GitHub",
    icon: IconGitHub,
  },
  {
    href: "mailto:yangkw003@gmail.com",
    label: "Email",
    title: "Send an email to Fucov",
    icon: IconMail,
  },
  {
    href: "https://blog.csdn.net/CSDN_WHO",
    label: "CSDN",
    title: "Fucov on CSDN",
    icon: IconCSDN,
  },
];
---

<section id="home-intro" class="border-b border-border py-10 sm:py-14">
  <div class="grid gap-8 md:grid-cols-[minmax(0,1.4fr)_18rem] md:items-end">
    <div>
      <p class="text-sm tracking-[0.18em] text-foreground/65 uppercase">
        Personal Blog
      </p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
        Fucov
      </h1>
      <p class="mt-4 text-lg text-foreground/80 sm:text-xl">
        AI Infra · Search / Ads / Recommendation
      </p>
      <p class="mt-3 text-sm tracking-[0.16em] text-foreground/65 uppercase">
        Go · Python · Java · C++
      </p>
      <p class="mt-6 max-w-2xl text-base leading-7 text-foreground/80">
        Writing about infrastructure, recommendation systems, and agent
        workflows from an engineering perspective. This site stays focused on
        code, systems, and the practical details behind building useful tools.
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        {
          introLinks.map(link => (
            <LinkButton
              href={link.href}
              class="rounded-full border border-border px-4 py-2 text-sm font-medium hover:border-accent"
              title={link.title}
            >
              <link.icon class="size-4 stroke-current" />
              <span>{link.label}</span>
            </LinkButton>
          ))
        }
      </div>
    </div>

    <div class="mx-auto w-full max-w-72 md:mx-0">
      <div class="overflow-hidden rounded-2xl border border-border bg-muted/30">
        <Image
          src={heroImage}
          alt="Abstract cover for Fucov personal blog"
          widths={[320, 480, 640]}
          sizes="(min-width: 768px) 18rem, min(100vw - 2rem, 18rem)"
          loading="eager"
          fetchpriority="high"
          class="h-auto w-full"
        />
      </div>
    </div>
  </div>
</section>
